{
  "name": "hookbuoy",
  "version": "0.3.1",
  "description": "Local-first Circle Wallets webhook fixture signing and exact replay (experimental)",
  "type": "module",
  "bin": {
    "hookbuoy": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run test",
    "prepack": "npm run build",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "files": [
    "dist/src/",
    "fixtures/",
    "examples/",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NothernZhongKui/hookbuoy.git"
  },
  "homepage": "https://github.com/NothernZhongKui/hookbuoy#readme",
  "bugs": {
    "url": "https://github.com/NothernZhongKui/hookbuoy/issues"
  }
}
